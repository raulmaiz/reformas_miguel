{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/reformas-miguel-frontend/browser",
  "installCommand": "npm install --legacy-peer-deps",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://reformas-miguel-backend.onrender.com/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
